# Optional. SharpAPI is the live odds feed. Without a key the app uses a synthetic board.
SHARPAPI_KEY=
# Optional leftover. Used only when SHARPAPI_KEY is empty.
ODDS_API_KEY=
# us covers DraftKings and FanDuel. uk and eu cover Bet365 and Pinnacle.
ODDS_API_REGIONS=us,uk,eu
# Optional. update.json is the usual place for owner/repo.
PUCKEDGE_UPDATE_REPO=
PUCKEDGE_UPDATE_BRANCH=main
